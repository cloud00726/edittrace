  ]
  for data in cases {
    let s = Session::new()
    let mut line = 0
    for raw in data.split("\n") {
      line = line + 1
      s.feed_line(raw.to_owned(), line)
    }
    let report = s.report()
    assert_eq(@model.int_field(report, "exit_code"), 0)
    assert_eq(
      @model.int_field(@model.field(report, "counts"), "checkpoints_passed"),
      8,
    )
  }
}
